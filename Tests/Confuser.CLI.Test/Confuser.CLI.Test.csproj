<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Confuser.CLI\Confuser.CLI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixture source files are test subjects, not part of this project -->
    <Compile Remove="Fixtures\**\*.cs" />
  </ItemGroup>

  <!-- Pre-build the SampleApp fixture so the test has a ready-made .exe -->
  <Target Name="BuildSampleApp" BeforeTargets="Build">
    <MSBuild Projects="Fixtures\SampleApp\SampleApp.csproj"
             Targets="Restore;Build"
             Properties="Configuration=Release;OutputPath=$([System.IO.Path]::GetFullPath('$(OutputPath)Fixtures\SampleApp\bin\'))" />
  </Target>

</Project>
